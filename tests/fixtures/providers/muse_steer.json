{
 "replies": {
  "initialize": {
   "serverInfo": {
    "name": "muse",
    "version": "1.4.3"
   },
   "userAgent": "muse-build/1.4.3 (non-interactive; linux-x86_64; build fixture)",
   "museHome": "~/.local/share/muse",
   "platformFamily": "unix",
   "platformOs": "linux",
   "schema": {
    "version": 1,
    "fingerprint": "sha256:fixture"
   },
   "grantedCapabilities": [
    "sessionMcp"
   ],
   "experimentalApi": false,
   "sessionDurability": "durable"
  },
  "session/setModel": {
   "status": "accepted"
  },
  "session/setApprovalMode": {
   "status": "accepted"
  },
  "turn/interrupt": {
   "status": "accepted"
  }
 },
 "steps": [
  {
   "expect": "session/start"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/started",
    "params": {
     "session": {
      "sessionId": "$params.sessionId",
      "status": "idle",
      "activeTurnId": null,
      "workspaceRoot": "$params.workspaceRoot",
      "providerId": "meta",
      "modelId": "$params.modelId",
      "turnCount": 0,
      "kind": "root"
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "session": {
      "sessionId": "$params.sessionId",
      "status": "idle",
      "activeTurnId": null,
      "workspaceRoot": "$params.workspaceRoot",
      "providerId": "meta",
      "modelId": "$params.modelId",
      "turnCount": 0,
      "kind": "root"
     },
     "viewCursor": "v:1"
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/approvalModeChanged",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "mode": "$params.approvalMode",
     "source": "approvalReconfigure"
    }
   }
  },
  {
   "expect": "turn/start"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "commandId": "$params.commandId",
     "status": "accepted",
     "turnId": "$params.commandId",
     "startedNewTurn": true,
     "disposition": "started"
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/statusChanged",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "status": "running"
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "turn/started",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "turnId": "$params:turn/start.commandId",
     "commandId": "$params:turn/start.commandId"
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "item/completed",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "item": {
      "turnId": "$params:turn/start.commandId",
      "itemId": "user-1",
      "kind": "userMessage",
      "revision": 1,
      "status": "completed",
      "text": "$params.displayText"
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "item/started",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "item": {
      "turnId": "$params:turn/start.commandId",
      "itemId": "reminder-1",
      "kind": "reminderChild",
      "revision": 1,
      "status": "inProgress",
      "fallbackText": "Reminder child session",
      "reminderAgentId": "skill-reminder"
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "item/started",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "item": {
      "turnId": "$params:turn/start.commandId",
      "itemId": "tool-1",
      "kind": "toolCall",
      "revision": 1,
      "status": "inProgress",
      "tool": "bash",
      "callId": "call_1",
      "args": "{\"command\": \"touch notes.txt\", \"description\": \"Create the notes file\"}"
     }
    }
   }
  },
  {
   "expect": "turn/steer"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "commandId": "$params.commandId",
     "status": "accepted",
     "turnId": "$params.expectedTurnId"
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "item/completed",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "item": {
      "turnId": "$params:turn/start.commandId",
      "itemId": "user-steer",
      "kind": "userMessage",
      "revision": 1,
      "status": "completed",
      "text": "$params.input.0.text"
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "item/completed",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "item": {
      "turnId": "$params:turn/start.commandId",
      "itemId": "tool-1",
      "kind": "toolCall",
      "revision": 2,
      "status": "completed",
      "tool": "bash",
      "callId": "call_1",
      "args": "{\"command\": \"touch notes.txt\", \"description\": \"Create the notes file\"}",
      "visibleOutput": "{\n  \"command\": \"touch notes.txt\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\",\n  \"truncated\": false\n}"
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "item/started",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "item": {
      "turnId": "$params:turn/start.commandId",
      "itemId": "message-1",
      "kind": "agentMessage",
      "revision": 1,
      "status": "inProgress",
      "text": ""
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "item/delta",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "itemId": "message-1",
     "field": "text",
     "delta": "Steered: printing the date too"
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "item/completed",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "item": {
      "turnId": "$params:turn/start.commandId",
      "itemId": "message-1",
      "kind": "agentMessage",
      "revision": 2,
      "status": "completed",
      "text": "Steered: printing the date too"
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/tokenUsage",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "turnId": "$params:turn/start.commandId",
     "modelId": "muse-spark-1.3-contributor",
     "usage": {
      "inputTokens": 32350,
      "outputTokens": 24,
      "cachedTokens": 0,
      "cacheWriteTokens": 0,
      "cacheReadTokens": 0,
      "reasoningTokens": 11
     },
     "promptTokens": 32350,
     "totalTokens": 32374,
     "durationMs": 1865
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/contextUsage",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "windowTokens": 1007997,
     "usedTokens": 32374,
     "pressure": "normal"
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "item/completed",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "item": {
      "turnId": "$params:turn/start.commandId",
      "itemId": "reminder-1",
      "kind": "reminderChild",
      "revision": 2,
      "status": "completed",
      "fallbackText": "Reminder child session",
      "reminderAgentId": "skill-reminder"
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/statusChanged",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "status": "idle"
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "turn/completed",
    "params": {
     "sessionId": "$params:session/start.sessionId",
     "turnId": "$params:turn/start.commandId",
     "terminal": "completed",
     "durationMs": 1200
    }
   }
  }
 ]
}

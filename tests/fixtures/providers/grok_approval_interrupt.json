{
 "replies": {
  "authenticate": {},
  "session/set_model": {},
  "session/set_mode": {},
  "session/set_config_option": {
   "configOptions": []
  },
  "session/close": {
   "_meta": {
    "x.ai/closeOutcome": "closed"
   }
  }
 },
 "steps": [
  {
   "expect": "initialize"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "protocolVersion": 1,
     "agentCapabilities": {
      "loadSession": true,
      "promptCapabilities": {
       "image": true,
       "embeddedContext": true
      },
      "sessionCapabilities": {
       "close": {}
      }
     },
     "authMethods": [
      {
       "id": "cached_token",
       "name": "Cached token"
      },
      {
       "id": "xai.api_key",
       "name": "API key"
      }
     ],
     "_meta": {
      "modelState": {
       "currentModelId": "grok-build",
       "availableModels": [
        {
         "modelId": "grok-build",
         "name": "Grok Build"
        },
        {
         "modelId": "grok-4-fast",
         "name": "Grok 4 Fast"
        }
       ]
      }
     }
    }
   }
  },
  {
   "expect": "session/new"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "sessionId": "grok-session-1",
     "models": {
      "currentModelId": "grok-build",
      "availableModels": [
       {
        "modelId": "grok-build",
        "name": "Grok Build"
       },
       {
        "modelId": "grok-4-fast",
        "name": "Grok 4 Fast"
       }
      ]
     }
    }
   }
  },
  {
   "expect": "session/prompt"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "grok-session-1",
     "update": {
      "sessionUpdate": "tool_call",
      "toolCallId": "call-1",
      "title": "Run `echo hi`",
      "kind": "execute",
      "status": "pending",
      "rawInput": {
       "command": "echo hi"
      }
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "perm-1",
    "method": "session/request_permission",
    "params": {
     "sessionId": "grok-session-1",
     "toolCall": {
      "toolCallId": "call-1",
      "kind": "execute",
      "title": "Run `echo hi`",
      "rawInput": {
       "command": "echo hi"
      }
     },
     "options": [
      {
       "optionId": "always-allow",
       "name": "Yes, and don't ask again for bash commands",
       "kind": "allow_always"
      },
      {
       "optionId": "allow-once",
       "name": "Yes",
       "kind": "allow_once"
      },
      {
       "optionId": "reject-once",
       "name": "No, and tell Grok what to do differently",
       "kind": "reject_once"
      }
     ]
    }
   }
  },
  {
   "expectReply": "perm-1"
  },
  {
   "expect": "session/cancel"
  }
 ]
}

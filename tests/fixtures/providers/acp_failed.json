{
 "replies": {
  "authenticate": {},
  "session/set_model": {},
  "session/set_mode": {},
  "session/set_config_option": {
   "configOptions": []
  },
  "session/close": {
   "_meta": {
    "x.ai/closeOutcome": "closed"
   }
  }
 },
 "steps": [
  {
   "expect": "initialize"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "protocolVersion": 1,
     "agentCapabilities": {
      "loadSession": true,
      "promptCapabilities": {
       "image": true,
       "embeddedContext": true
      },
      "sessionCapabilities": {
       "close": {}
      }
     },
     "agentInfo": {
      "name": "fixture-acp",
      "version": "1.2.3"
     },
     "authMethods": []
    }
   }
  },
  {
   "expect": "session/new"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "sessionId": "acp-session-1",
     "models": {
      "currentModelId": "fixture-small",
      "availableModels": [
       {
        "modelId": "fixture-small",
        "name": "Fixture Small"
       },
       {
        "modelId": "fixture-large",
        "name": "Fixture Large"
       }
      ]
     }
    }
   }
  },
  {
   "expect": "session/prompt"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "acp-session-1",
     "update": {
      "sessionUpdate": "agent_message_chunk",
      "content": {
       "type": "text",
       "text": "Working on it."
      }
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "error": {
     "code": -32603,
     "message": "Internal error: the fixture agent failed"
    }
   }
  }
 ]
}

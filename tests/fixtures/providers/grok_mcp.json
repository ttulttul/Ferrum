     "update": {
      "sessionUpdate": "tool_call",
      "toolCallId": "call-mcp",
      "title": "use_tool",
      "status": "pending",
      "rawInput": {
       "tool_name": "t3-code__t3_thread_list",
       "tool_input": {}
      },
      "_meta": {
       "x.ai/tool": {
        "name": "use_tool"
       }
      }
     }
    }
   }
  },
  {
   "mcp": {
    "method": "tools/list"
   }
  },
  {

      }
     ],
     "_meta": {
      "modelState": {
       "currentModelId": "grok-build",
       "availableModels": [
        {
         "modelId": "grok-build",
         "name": "Grok Build"
        },
        {
         "modelId": "grok-4-fast",
         "name": "Grok 4 Fast"
        }
       ]
      }
     }
    }
   }
  },
  {
   "expect": "session/new"
  },
  {

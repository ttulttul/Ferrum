{
 "replies": {
  "authenticate": {},
  "session/set_model": {},
  "session/set_mode": {},
  "session/set_config_option": {
   "configOptions": []
  }
 },
 "steps": [
  {
   "expect": "initialize"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "protocolVersion": 1,
     "agentCapabilities": {
      "loadSession": true,
      "promptCapabilities": {
       "image": true,
       "embeddedContext": true
      }
     },
     "agentInfo": {
      "name": "agy",
      "version": "1.6.2"
     },
     "authMethods": [
      {
       "id": "oauth-personal",
       "name": "Google"
      }
     ]
    }
   }
  },
  {
   "expect": "session/new"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "sessionId": "0b6a3c1e-5d2f-4a8b-9c7d-1e2f3a4b5c6d",
     "models": {
      "currentModelId": "fixture-small",
      "availableModels": [
       {
        "modelId": "fixture-small",
        "name": "Fixture Small"
       },
       {
        "modelId": "fixture-large",
        "name": "Fixture Large"
       }
      ]
     },
     "modes": {
      "currentModeId": "default",
      "availableModes": [
       {
        "id": "default",
        "name": "Default"
       },
       {
        "id": "auto_edit",
        "name": "Auto edit"
       },
       {
        "id": "yolo",
        "name": "YOLO"
       }
      ]
     }
    }
   }
  },
  {
   "expect": "session/prompt"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "0b6a3c1e-5d2f-4a8b-9c7d-1e2f3a4b5c6d",
     "update": {
      "sessionUpdate": "agent_message_chunk",
      "content": {
       "type": "text",
       "text": "Running it."
      }
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "0b6a3c1e-5d2f-4a8b-9c7d-1e2f3a4b5c6d",
     "update": {
      "sessionUpdate": "tool_call",
      "toolCallId": "call-1",
      "title": "Run `echo hi`",
      "kind": "execute",
      "status": "pending",
      "rawInput": {
       "CommandLine": "echo hi",
       "Cwd": "/workspace"
      }
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "0b6a3c1e-5d2f-4a8b-9c7d-1e2f3a4b5c6d",
     "update": {
      "sessionUpdate": "tool_call_update",
      "toolCallId": "call-1",
      "status": "in_progress"
     }
    }
   }
  },
  {
   "expect": "session/cancel"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "0b6a3c1e-5d2f-4a8b-9c7d-1e2f3a4b5c6d",
     "update": {
      "sessionUpdate": "tool_call_update",
      "toolCallId": "call-1",
      "status": "cancelled"
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id:session/prompt",
    "result": {
     "stopReason": "cancelled"
    }
   }
  }
 ]
}

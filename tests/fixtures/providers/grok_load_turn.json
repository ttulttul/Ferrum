{
 "replies": {
  "authenticate": {},
  "session/set_model": {},
  "session/set_mode": {},
  "session/set_config_option": {
   "configOptions": []
  },
  "session/close": {
   "_meta": {
    "x.ai/closeOutcome": "closed"
   }
  }
 },
 "steps": [
  {
   "expect": "session/load"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "grok-session-1",
     "update": {
      "sessionUpdate": "user_message_chunk",
      "content": {
       "type": "text",
       "text": "Run echo hi and write notes.txt"
      },
      "_meta": {
       "isReplay": true
      }
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "models": {
      "currentModelId": "grok-build",
      "availableModels": [
       {
        "modelId": "grok-build",
        "name": "Grok Build"
       }
      ]
     }
    }
   }
  },
  {
   "expect": "session/prompt"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "grok-session-1",
     "update": {
      "sessionUpdate": "agent_message_chunk",
      "content": {
       "type": "text",
       "text": "Appended a line."
      }
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "stopReason": "end_turn"
    }
   }
  }
 ]
}

  }
 },
 "steps": [
  {
   "expect": "initialize"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "protocolVersion": 1,
     "agentCapabilities": {
      "loadSession": true,
      "promptCapabilities": {
       "image": true,
       "embeddedContext": true
      }
     },
     "agentInfo": {
      "name": "agy",
      "version": "1.6.2"
     },
     "authMethods": [
      {
       "id": "oauth-personal",
       "name": "Google"
      }
     ]
    }
   }
  },
  {
   "expect": "session/new"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "sessionId": "0b6a3c1e-5d2f-4a8b-9c7d-1e2f3a4b5c6d",
     "models": {
      "currentModelId": "fixture-small",
      "availableModels": [
       {
        "modelId": "fixture-small",
        "name": "Fixture Small"
       },
       {
        "modelId": "fixture-large",
        "name": "Fixture Large"
       }
      ]
     },
     "modes": {
      "currentModeId": "default",
      "availableModes": [
       {
        "id": "default",
        "name": "Default"
       },
       {
        "id": "auto_edit",
        "name": "Auto edit"
       },
       {
        "id": "yolo",
        "name": "YOLO"
       }
      ]
     }
    }
   }
  },
  {
   "expect": "session/prompt"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "0b6a3c1e-5d2f-4a8b-9c7d-1e2f3a4b5c6d",
     "update": {
      "sessionUpdate": "tool_call",
      "toolCallId": "edit-1",
      "title": "Run edit_file?",
      "kind": "edit",
      "status": "pending",
      "content": [
       {
        "type": "diff",
        "path": "/workspace/notes/acc.txt",
        "oldText": null,
        "newText": "ferrum\n"
       }
      ],
      "locations": [
       {
        "path": "/workspace/notes/acc.txt"
       }
      ],
      "rawInput": {
       "TargetFile": "/workspace/notes/acc.txt",
       "CodeContent": "ferrum\n"
      }
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "perm-1",
    "method": "session/request_permission",
    "params": {
     "sessionId": "0b6a3c1e-5d2f-4a8b-9c7d-1e2f3a4b5c6d",
     "toolCall": {
      "toolCallId": "edit-1",
      "kind": "edit",
      "title": "Run edit_file?",
      "locations": [
       {
        "path": "/workspace/notes/acc.txt"
       }
      ]
     },
     "options": [
      {
       "optionId": "allow-always",
       "name": "Always allow",
       "kind": "allow_always"
      },
      {
       "optionId": "allow",
       "name": "Allow",
       "kind": "allow_once"
      },
      {
       "optionId": "reject",
       "name": "Deny",
       "kind": "reject_once"
      }
     ]
    }
   }
  },
  {
   "expectReply": "perm-1"
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "0b6a3c1e-5d2f-4a8b-9c7d-1e2f3a4b5c6d",
     "update": {
      "sessionUpdate": "tool_call_update",
      "toolCallId": "edit-1",
      "kind": "edit",
      "status": "in_progress",
      "title": "Running edit_file",
      "locations": [
       {
        "path": "/workspace/notes/acc.txt"
       }
      ],
      "rawInput": {
       "file_path": "/workspace/notes/acc.txt"
      }
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "0b6a3c1e-5d2f-4a8b-9c7d-1e2f3a4b5c6d",
     "update": {
      "sessionUpdate": "tool_call_update",
      "toolCallId": "edit-1",
      "status": "completed",
      "rawOutput": "Tool execution"
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "0b6a3c1e-5d2f-4a8b-9c7d-1e2f3a4b5c6d",
     "update": {
      "sessionUpdate": "agent_message_chunk",
      "content": {
       "type": "text",
       "text": "Created notes/acc.txt."
      }
     }
    }
   }
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": "$id",
    "result": {
     "stopReason": "end_turn"
    }
   }
  }
 ]
}

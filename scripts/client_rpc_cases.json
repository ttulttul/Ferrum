{
  "about": "Calls client_rpc_driver.mjs makes through the reference client runtime, in order. Names start with the area used for the xfail list. compare: value (normalized decoded value, the default), shape (types and keys only), signature (outcome and discriminator), kinds (discriminator of each stream item), outcome (reply/error/silent only). $NAME is substituted from the harness variables; $step:<name>.<path> reads an earlier reply.",
  "steps": [
    {"name": "connect.server.probe", "rpc": "server.probe"},
    {"parallel": [
      {"name": "connect.subscribeServerLifecycle", "rpc": "subscribeServerLifecycle", "stream": {"take": 1}, "compare": "shape"},
      {"name": "connect.subscribeAuthAccess", "rpc": "subscribeAuthAccess", "stream": {"take": 1}, "compare": "shape"},
      {"name": "connect.subscribeDeviceState", "rpc": "subscribeDeviceState", "stream": {"take": 1}, "compare": "shape"},
      {"name": "connect.subscribeProjectClones", "rpc": "subscribeProjectClones", "stream": {"take": 1}},
      {"name": "connect.subscribeServerConfig", "rpc": "subscribeServerConfig", "input": {"environmentThemes": true, "usageLimitSources": true, "usageLimitsCommand": true}, "stream": {"take": 1}, "compare": "kinds"},
      {"name": "connect.subscribeTerminalMetadata", "rpc": "subscribeTerminalMetadata", "stream": {"take": 1}},
      {"name": "connect.subscribePreviewEvents", "rpc": "subscribePreviewEvents", "stream": {"take": 1}, "timeoutMs": 2500, "compare": "signature"},
      {"name": "connect.subscribeDiscoveredLocalServers", "rpc": "subscribeDiscoveredLocalServers", "input": {"configuredUrls": []}, "stream": {"take": 1}, "timeoutMs": 2500, "compare": "signature"},
      {"name": "connect.pullRequests.subscribeRefreshes", "rpc": "pullRequests.subscribeRefreshes", "stream": {"take": 1}, "timeoutMs": 2500, "compare": "signature"},
      {"name": "connect.pullRequests.subscribeLinkedThreadRefreshes", "rpc": "pullRequests.subscribeLinkedThreadRefreshes", "stream": {"take": 1}, "timeoutMs": 2500, "compare": "signature"},
      {"name": "connect.scheduledTasks.subscribe", "rpc": "scheduledTasks.subscribe", "stream": {"take": 1}, "compare": "shape"},
      {"name": "connect.server.reportClientActivity", "rpc": "server.reportClientActivity", "input": {"environmentId": "$ENV", "clientId": "client-rpc-parity", "clientKind": "desktop", "visible": true, "focused": true, "recentlyInteracted": true, "appState": "active", "scopes": [{"type": "provider-status"}], "ttlMs": 45000, "observedAt": {"$dateTime": "now"}}},
      {"name": "connect.preview.reportProfiles", "rpc": "preview.reportProfiles", "input": {"profiles": [], "defaultProfileId": "default", "recordingFrameRate": 30}},
      {"name": "connect.server.refreshProviders", "rpc": "server.refreshProviders", "input": {"workspaceSnapshotsOnDemand": true}, "compare": "signature"},
      {"name": "connect.http.shellSnapshot", "http": true, "group": "orchestration", "endpoint": "shellSnapshot", "method": "GET", "path": "/api/orchestration/shell", "args": {"query": {}}, "orchestrationHeader": true, "responseOnly": true, "compare": "signature"}
    ]},
    {"name": "connect.peerLinks.list", "rpc": "peerLinks.list"},
    {"name": "connect.issueTrackers.list", "rpc": "issueTrackers.list", "compare": "shape"},
    {"name": "connect.cloud.getRelayClientStatus", "rpc": "cloud.getRelayClientStatus", "compare": "shape"},
    {"name": "connect.server.getUsageSummary", "rpc": "server.getUsageSummary", "input": {"sinceDay": "2026-11-01", "untilDay": "2026-11-02", "timeZone": "UTC"}, "compare": "shape"},
    {"name": "connect.http.connectLinkState", "http": true, "group": "connect", "endpoint": "linkState", "method": "GET", "path": "/api/connect/link-state", "compare": "shape"},
    {"name": "connect.http.voiceStatus", "http": true, "group": "voice", "endpoint": "status", "method": "GET", "path": "/api/voice/status", "compare": "shape"},

    {"name": "projects.http.snapshot.empty", "http": true, "group": "projects", "endpoint": "snapshot", "method": "GET", "path": "/api/projects", "compare": "shape"},
    {"name": "projects.shellFollow.start", "rpc": "orchestration.subscribeShell", "input": {"requestCompletionMarker": true}, "stream": {"background": true}},
    {"name": "projects.create", "rpc": "projects.mutate", "input": {"type": "project.create", "commandId": "cmd-project-create", "projectId": "project:client-rpc", "title": "Client RPC", "workspaceRoot": "$REPO"}},
    {"name": "projects.shellFollow.sawProject", "await": "projects.shellFollow.start", "until": {"kind": "project.updated", "project": {"id": "project:client-rpc"}}, "lastOnly": true, "compare": "value"},
    {"name": "projects.create.duplicate", "rpc": "projects.mutate", "input": {"type": "project.create", "commandId": "cmd-project-create-2", "projectId": "project:client-rpc", "title": "Client RPC", "workspaceRoot": "$REPO"}, "compare": "signature"},
    {"name": "projects.create.missingRoot", "rpc": "projects.mutate", "input": {"type": "project.create", "commandId": "cmd-project-missing", "projectId": "project:missing-root", "title": "Missing", "workspaceRoot": "$HOME/does-not-exist"}, "compare": "signature"},
    {"name": "projects.shellRename.start", "rpc": "orchestration.subscribeShell", "input": {"requestCompletionMarker": true}, "stream": {"background": true}},
    {"name": "projects.update", "rpc": "projects.mutate", "input": {"type": "project.update", "commandId": "cmd-project-update", "projectId": "project:client-rpc", "title": "Client RPC renamed"}},
    {"name": "projects.shellRename.sawRename", "await": "projects.shellRename.start", "until": {"kind": "project.updated", "project": {"title": "Client RPC renamed"}}, "lastOnly": true, "compare": "value"},
    {"name": "projects.shellRename.replay", "rpc": "orchestration.subscribeShell", "input": {"afterSequence": "$step:projects.shellFollow.sawProject.items.0.sequence", "requestCompletionMarker": true, "httpSnapshotFallback": true}, "stream": {"until": {"kind": "synchronized"}, "dropIdentityRefreshes": true}, "compare": "value"},
    {"name": "projects.listEntries", "rpc": "projects.listEntries", "input": {"cwd": "$REPO"}},
    {"name": "projects.listEntries.ignoreRules", "rpc": "projects.listEntries", "input": {"cwd": "$HOME/listing"}},
    {"name": "projects.listEntries.linkedRoot", "rpc": "projects.listEntries", "input": {"cwd": "$HOME/listing-link"}},
    {"name": "projects.listEntries.rootDirectory", "rpc": "projects.listEntries", "input": {"cwd": "$HOME/listing", "directoryPath": ""}},
    {"name": "projects.listEntries.ignoredDirectory", "rpc": "projects.listEntries", "input": {"cwd": "$HOME/listing", "directoryPath": "output"}},
    {"name": "projects.listEntries.directoryLink", "rpc": "projects.listEntries", "input": {"cwd": "$HOME/listing", "directoryPath": "alias"}},
    {"name": "projects.listEntries.plain", "rpc": "projects.listEntries", "input": {"cwd": "$HOME/listing-plain"}},
    {"name": "projects.listIgnoredFiles.cap", "rpc": "projects.listIgnoredFiles", "input": {"cwd": "$HOME/listing"}},
    {"name": "projects.listIgnoredFiles.queryPastCap", "rpc": "projects.listIgnoredFiles", "input": {"cwd": "$HOME/listing", "query": "LOG-200"}},
    {"name": "projects.listEntries.cap", "rpc": "projects.listEntries", "input": {"cwd": "$HOME/listing-cap"}, "timeoutMs": 30000},
    {"name": "projects.listEntries.missingCwd", "rpc": "projects.listEntries", "input": {"cwd": "$HOME/does-not-exist"}, "compare": "signature"},
    {"name": "projects.listIgnoredFiles", "rpc": "projects.listIgnoredFiles", "input": {"cwd": "$REPO"}},
    {"name": "projects.readFile", "rpc": "projects.readFile", "input": {"cwd": "$REPO", "relativePath": "README.md"}},
    {"name": "projects.readFile.missing", "rpc": "projects.readFile", "input": {"cwd": "$REPO", "relativePath": "nope.txt"}, "compare": "signature"},
    {"name": "projects.readFile.escape", "rpc": "projects.readFile", "input": {"cwd": "$REPO", "relativePath": "../outside.txt"}, "compare": "signature"},
    {"name": "projects.searchEntries", "rpc": "projects.searchEntries", "input": {"cwd": "$REPO", "query": "read", "limit": 10}},
    {"name": "projects.searchEntries.fuzzy", "rpc": "projects.searchEntries", "input": {"cwd": "$REPO", "query": "gde", "limit": 10}},
    {"name": "projects.searchEntries.directories", "rpc": "projects.searchEntries", "input": {"cwd": "$REPO", "query": "sr", "limit": 10, "kind": "directory"}},
    {"name": "projects.searchEntries.images", "rpc": "projects.searchEntries", "input": {"cwd": "$REPO", "query": "logo", "limit": 10, "imageOnly": true}},
    {"name": "projects.searchContents", "rpc": "projects.searchContents", "input": {"cwd": "$REPO", "query": "parity", "limit": 10, "caseSensitive": false, "wholeWord": false, "useRegex": false}},
    {"name": "projects.searchContents.wholeWord", "rpc": "projects.searchContents", "input": {"cwd": "$REPO", "query": "parity", "limit": 10, "caseSensitive": false, "wholeWord": true, "useRegex": false}},
    {"name": "projects.searchContents.unicode", "rpc": "projects.searchContents", "input": {"cwd": "$REPO", "query": "é", "limit": 10, "caseSensitive": true, "wholeWord": false, "useRegex": false}},
    {"name": "projects.searchContents.regex", "rpc": "projects.searchContents", "input": {"cwd": "$REPO", "query": "fn [a-z]+", "limit": 10, "caseSensitive": true, "wholeWord": false, "useRegex": true}},
    {"name": "projects.searchContents.regexRanges", "rpc": "projects.searchContents", "input": {"cwd": "$REPO", "query": "[a-z]e", "limit": 10, "caseSensitive": true, "wholeWord": false, "useRegex": true}},
    {"name": "projects.writeFile", "rpc": "projects.writeFile", "input": {"cwd": "$REPO", "relativePath": "notes/new.txt", "contents": "written by the client\n"}},
    {"name": "projects.readFile.afterWrite", "rpc": "projects.readFile", "input": {"cwd": "$REPO", "relativePath": "notes/new.txt"}},
    {"name": "projects.filesystem.browse", "rpc": "filesystem.browse", "input": {"partialPath": "$REPO/"}},
    {"name": "projects.filesystem.getMetadata", "rpc": "filesystem.getMetadata", "input": {"paths": ["$REPO/README.md", "$REPO/missing.txt"]}, "compare": "shape"},
    {"name": "projects.agentSessions.scan", "rpc": "agentSessions.scan", "input": {}, "compare": "shape"},
    {"name": "projects.http.snapshot", "http": true, "group": "projects", "endpoint": "snapshot", "method": "GET", "path": "/api/projects", "compare": "shape"},

    {"name": "threads.create", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.create", "commandId": "cmd-thread-a", "threadId": "thread:client-rpc-a", "projectId": "project:client-rpc", "title": "Thread A", "modelSelection": {"instanceId": "codex", "model": "fixture"}, "runtimeMode": "full-access", "interactionMode": "default", "branch": null, "worktreePath": null, "createdBy": "user", "creationSource": "web"}},
    {"name": "threads.create.second", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.create", "commandId": "cmd-thread-b", "threadId": "thread:client-rpc-b", "projectId": "project:client-rpc", "title": "Thread B", "modelSelection": {"instanceId": "codex", "model": "fixture"}, "runtimeMode": "approval-required", "interactionMode": "plan", "branch": "main", "worktreePath": null, "createdBy": "user", "creationSource": "web"}},
    {"name": "threads.create.unknownProject", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.create", "commandId": "cmd-thread-x", "threadId": "thread:client-rpc-x", "projectId": "project:absent", "title": "Orphan", "modelSelection": {"instanceId": "codex", "model": "fixture"}, "runtimeMode": "full-access", "interactionMode": "default", "branch": null, "worktreePath": null, "createdBy": "user", "creationSource": "web"}, "compare": "signature"},
    {"name": "threads.shellFollow.start", "rpc": "orchestration.subscribeShell", "input": {"requestCompletionMarker": true}, "stream": {"background": true}},
    {"name": "threads.create.third", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.create", "commandId": "cmd-thread-c", "threadId": "thread:client-rpc-c", "projectId": "project:client-rpc", "title": "Thread C", "modelSelection": {"instanceId": "codex", "model": "fixture"}, "runtimeMode": "full-access", "interactionMode": "default", "branch": null, "worktreePath": null, "createdBy": "user", "creationSource": "web"}},
    {"name": "threads.shellFollow.sawThread", "await": "threads.shellFollow.start", "until": {"kind": "thread.updated", "thread": {"id": "thread:client-rpc-c"}}, "lastOnly": true, "compare": "value"},
    {"name": "threads.subscribeShell.synchronized", "rpc": "orchestration.subscribeShell", "input": {"requestCompletionMarker": true}, "stream": {"until": {"kind": "synchronized"}, "dropIdentityRefreshes": true}, "compare": "kinds"},
    {"name": "threads.subscribeThread.synchronized", "rpc": "orchestration.subscribeThread", "input": {"threadId": "thread:client-rpc-a", "requestCompletionMarker": true, "acceptBoundedSnapshot": true, "acceptDeferredWork": true, "acceptCompactTurnItems": true, "acceptCompactIds": true, "acceptDedupedBodies": true}, "stream": {"until": {"kind": "synchronized"}, "dropIdentityRefreshes": true}, "compare": "kinds"},
    {"name": "threads.subscribeThread.missing", "rpc": "orchestration.subscribeThread", "input": {"threadId": "thread:absent", "requestCompletionMarker": true}, "stream": {"take": 1}, "compare": "signature"},
    {"name": "threads.threadFollow.start", "rpc": "orchestration.subscribeThread", "input": {"threadId": "thread:client-rpc-a", "requestCompletionMarker": true, "acceptBoundedSnapshot": true, "acceptDeferredWork": true, "acceptCompactTurnItems": true, "acceptCompactIds": true, "acceptDedupedBodies": true}, "stream": {"background": true}},
    {"name": "threads.rename", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.metadata.update", "commandId": "cmd-rename-a", "threadId": "thread:client-rpc-a", "title": "Renamed by the client"}},
    {"name": "threads.threadFollow.sawRename", "await": "threads.threadFollow.start", "untilText": "Renamed by the client", "lastOnly": true, "compare": "kinds"},
    {"name": "threads.pin", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.pin", "commandId": "cmd-pin-a", "threadId": "thread:client-rpc-a"}},
    {"name": "threads.tag", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.tag.set", "commandId": "cmd-tag-a", "threadId": "thread:client-rpc-a", "tag": "parity", "tagged": true}, "compare": "signature"},
    {"name": "threads.visit", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.visit", "commandId": "cmd-visit-a", "threadId": "thread:client-rpc-a", "visitedAt": "2026-11-11T10:12:13.000Z"}},
    {"name": "threads.runtimeMode", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.runtime-mode.set", "commandId": "cmd-mode-b", "threadId": "thread:client-rpc-b", "runtimeMode": "full-access"}},
    {"name": "threads.shellArchive.start", "rpc": "orchestration.subscribeShell", "input": {"requestCompletionMarker": true}, "stream": {"background": true}},
    {"name": "threads.archive", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.archive", "commandId": "cmd-archive-c", "threadId": "thread:client-rpc-c"}},
    {"name": "threads.shellArchive.sawArchive", "await": "threads.shellArchive.start", "until": {"kind": "thread.removed", "location": "active", "threadId": "thread:client-rpc-c"}, "lastOnly": true, "compare": "value"},
    {"name": "threads.getArchivedShellSnapshot", "rpc": "orchestration.getArchivedShellSnapshot", "input": {}, "compare": "kinds"},
    {"name": "threads.shellUnarchive.start", "rpc": "orchestration.subscribeShell", "input": {"requestCompletionMarker": true}, "stream": {"background": true}},
    {"name": "threads.unarchive", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.unarchive", "commandId": "cmd-unarchive-c", "threadId": "thread:client-rpc-c"}},
    {"name": "threads.shellUnarchive.sawUnarchive", "await": "threads.shellUnarchive.start", "until": {"kind": "thread.updated", "location": "active", "thread": {"id": "thread:client-rpc-c"}}, "lastOnly": true, "compare": "value"},
    {"name": "threads.shellDelete.start", "rpc": "orchestration.subscribeShell", "input": {"requestCompletionMarker": true}, "stream": {"background": true}},
    {"name": "threads.delete", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.delete", "commandId": "cmd-delete-c", "threadId": "thread:client-rpc-c"}},
    {"name": "threads.shellDelete.sawDelete", "await": "threads.shellDelete.start", "until": {"kind": "thread.removed", "location": "active", "threadId": "thread:client-rpc-c"}, "lastOnly": true, "compare": "value"},
    {"name": "threads.getThreadTitles", "rpc": "orchestration.getThreadTitles", "input": {"threadIds": ["thread:client-rpc-a", "thread:client-rpc-b", "thread:client-rpc-c", "thread:absent"]}},
    {"name": "threads.getThreadLinkMetadata", "rpc": "orchestration.getThreadLinkMetadata", "input": {"threadIds": ["thread:client-rpc-a", "thread:absent"]}},
    {"name": "threads.getThreadFamily", "rpc": "orchestration.getThreadFamily", "input": {"threadId": "thread:client-rpc-a"}},
    {"name": "threads.getThreadProjection", "rpc": "orchestration.getThreadProjection", "input": {"threadId": "thread:client-rpc-a"}, "compare": "shape"},
    {"name": "threads.getWorktreeThreadIds", "rpc": "orchestration.getWorktreeThreadIds", "input": {"worktreePath": "$REPO"}},
    {"name": "threads.getOlderSettledThreads", "rpc": "orchestration.getOlderSettledThreads", "input": {"before": {"settledAt": "2030-01-01T00:00:00.000Z"}, "limit": 10}},
    {"name": "threads.searchThreads", "rpc": "orchestration.searchThreads", "input": {"query": "Renamed"}, "compare": "value"},
    {"name": "threads.searchThread", "rpc": "orchestration.searchThread", "input": {"threadId": "thread:client-rpc-a", "query": "hello"}, "compare": "value"},
    {"name": "threads.searchThreadStream", "rpc": "orchestration.searchThreadStream", "input": {"threadId": "thread:client-rpc-a", "query": "hello"}, "stream": {"take": 3}, "timeoutMs": 3000, "compare": "value"},
    {"name": "threads.subscribePromptSuggestion", "rpc": "orchestration.subscribePromptSuggestion", "input": {"threadId": "thread:client-rpc-a"}, "stream": {"take": 1}, "timeoutMs": 2500, "compare": "signature"},
    {"name": "threads.http.boundedSnapshot", "http": true, "group": "orchestration", "endpoint": "threadBoundedSnapshot", "method": "GET", "path": "/api/orchestration/threads/:threadId/bounded", "args": {"params": {"threadId": "thread:client-rpc-a"}, "query": {"compactTurnItems": "1", "dedupeBodies": "1", "compactIds": "1", "deferWork": "1"}}, "orchestrationHeader": true, "compare": "shape"},
    {"name": "threads.http.transcript", "http": true, "group": "orchestration", "endpoint": "threadTranscript", "method": "GET", "path": "/api/orchestration/threads/:threadId/transcript", "args": {"params": {"threadId": "thread:client-rpc-a"}}, "orchestrationHeader": true, "compare": "shape"},
    {"name": "threads.http.transcript.missing", "http": true, "group": "orchestration", "endpoint": "threadTranscript", "method": "GET", "path": "/api/orchestration/threads/:threadId/transcript", "args": {"params": {"threadId": "thread:absent"}}, "orchestrationHeader": true, "compare": "signature"},
    {"name": "threads.http.history.badCursor", "http": true, "group": "orchestration", "endpoint": "threadHistoryPage", "method": "GET", "path": "/api/orchestration/threads/:threadId/history", "args": {"params": {"threadId": "thread:client-rpc-a"}, "query": {"cursor": "not-a-cursor", "compactIds": "1"}}, "orchestrationHeader": true, "compare": "signature"},
    {"name": "threads.subscribeWorktreeSetup", "rpc": "subscribeWorktreeSetup", "input": {"threadId": "thread:client-rpc-a"}, "stream": {"take": 1}, "timeoutMs": 4000},
    {"name": "threads.worktreeSetup.cancel", "rpc": "worktreeSetup.cancel", "input": {"threadId": "thread:client-rpc-a"}, "compare": "signature"},
    {"name": "threads.guestShare.create.missing", "rpc": "guestShare.create", "input": {"threadId": "thread:absent"}, "compare": "signature"},

    {"name": "turns.message.deferred", "rpc": "orchestration.dispatchCommand", "input": {"type": "message.dispatch", "commandId": "cmd-message-a", "threadId": "thread:client-rpc-a", "messageId": "message:client-rpc-1", "text": "hello from the parity client", "attachments": [], "dispatchMode": {"type": "defer_start"}, "createdBy": "user", "creationSource": "web"}},
    {"name": "turns.message.missingProvider", "rpc": "orchestration.dispatchCommand", "input": {"type": "message.dispatch", "commandId": "cmd-message-b", "threadId": "thread:client-rpc-b", "messageId": "message:client-rpc-2", "text": "start a turn", "attachments": [], "modelSelection": {"instanceId": "parity-absent", "model": "none"}, "dispatchMode": {"type": "start_immediately"}, "createdBy": "user", "creationSource": "web"}, "compare": "signature"},
    {"name": "turns.subscribeThread.afterMessage", "rpc": "orchestration.subscribeThread", "input": {"threadId": "thread:client-rpc-a", "requestCompletionMarker": true, "acceptBoundedSnapshot": true, "acceptDeferredWork": true, "acceptCompactTurnItems": true, "acceptCompactIds": true, "acceptDedupedBodies": true}, "stream": {"until": {"kind": "synchronized"}, "dropIdentityRefreshes": true}, "compare": "kinds"},
    {"name": "turns.getThreadProjection.afterMessage", "rpc": "orchestration.getThreadProjection", "input": {"threadId": "thread:client-rpc-a"}, "compare": "shape"},
    {"name": "turns.getTurnDiff.empty", "rpc": "orchestration.getTurnDiff", "input": {"threadId": "thread:client-rpc-a", "fromTurnCount": 0, "toTurnCount": 0}},
    {"name": "turns.getFullThreadDiff.empty", "rpc": "orchestration.getFullThreadDiff", "input": {"threadId": "thread:client-rpc-a", "toTurnCount": 0}},
    {"name": "turns.getTurnDiff.missingThread", "rpc": "orchestration.getTurnDiff", "input": {"threadId": "thread:absent", "fromTurnCount": 0, "toTurnCount": 1}, "compare": "signature"},
    {"name": "turns.getTurnItem.missing", "rpc": "orchestration.getTurnItem", "input": {"threadId": "thread:client-rpc-a", "itemId": "item:missing"}, "compare": "signature"},
    {"name": "turns.getNativeChildWork", "rpc": "orchestration.getNativeChildWork", "input": {"threadId": "thread:client-rpc-a"}},
    {"name": "turns.subscribeCommandOutput.missing", "rpc": "orchestration.subscribeCommandOutput", "input": {"threadId": "thread:client-rpc-a", "itemId": "item:missing"}, "stream": {"take": 1}, "timeoutMs": 2500, "compare": "signature"},
    {"name": "turns.stop", "rpc": "orchestration.dispatchCommand", "input": {"type": "thread.stop", "commandId": "cmd-stop-a", "threadId": "thread:client-rpc-a"}, "compare": "signature"},
    {"name": "turns.forceStopThread", "rpc": "orchestration.forceStopThread", "input": {"threadId": "thread:client-rpc-a"}, "compare": "signature"},
    {"name": "turns.queuedRun.cancel.missing", "rpc": "orchestration.dispatchCommand", "input": {"type": "queued-run.cancel", "commandId": "cmd-cancel-missing", "threadId": "thread:client-rpc-a", "runId": "00000000-0000-4000-8000-000000000001"}, "compare": "signature"},

    {"name": "attachments.createUploadUrl", "rpc": "attachments.createUploadUrl", "input": {"type": "file", "name": "notes.txt", "mimeType": "text/plain", "sizeBytes": 6}, "compare": "grant"},
    {"name": "attachments.upload", "fetch": {"method": "POST", "url": "$step:attachments.createUploadUrl.relativeUrl", "bearer": false, "headers": {"content-type": "text/plain"}, "body": "hello\n"}, "call": "POST /api/attachments/upload/:token"},
    {"name": "attachments.upload.again", "fetch": {"method": "POST", "url": "$step:attachments.createUploadUrl.relativeUrl", "bearer": false, "headers": {"content-type": "text/plain"}, "body": "hello\n"}, "call": "POST /api/attachments/upload/:token"},
    {"name": "attachments.upload.conflict", "fetch": {"method": "POST", "url": "$step:attachments.createUploadUrl.relativeUrl", "bearer": false, "bodyText": true, "body": "world\n"}, "call": "POST /api/attachments/upload/:token"},
    {"name": "attachments.upload.short", "fetch": {"method": "POST", "url": "$step:attachments.createUploadUrl.relativeUrl", "bearer": false, "bodyText": true, "body": "short"}, "call": "POST /api/attachments/upload/:token"},
    {"name": "attachments.upload.expired", "fetch": {"method": "POST", "url": "$EXPIRED_UPLOAD", "bearer": false, "bodyText": true, "body": "x"}, "call": "POST /api/attachments/upload/:token"},
    {"name": "attachments.upload.badToken", "fetch": {"method": "POST", "url": "/api/attachments/upload/not-a-token", "bearer": false, "headers": {"content-type": "text/plain"}, "body": "hello\n"}, "call": "POST /api/attachments/upload/:token"},
    {"name": "attachments.createUploadUrl.tooLarge", "rpc": "attachments.createUploadUrl", "input": {"type": "image", "name": "huge.png", "mimeType": "image/png", "sizeBytes": 999999999}, "compare": "signature"},
